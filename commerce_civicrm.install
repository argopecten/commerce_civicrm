<?php

use Drupal\Core\Extension\Requirement\RequirementSeverity;

/**
 * @file
 * Install, update and uninstall functions for the Commerce CiviCRM module.
 */

/**
 * Implements hook_runtime_requirements().
 */
function commerce_civicrm_runtime_requirements() {
  $requirements = [];
  
  // Check if CiviCRM module is enabled
  if (!\Drupal::hasService('civicrm')) {
    $requirements['commerce_civicrm_civicrm'] = [
      'title' => t('Commerce CiviCRM - CiviCRM Module'),
      'description' => t('CiviCRM module is required but not enabled.'),
      'severity' => RequirementSeverity::Error,
      'value' => t('Not available'),
    ];
  }
  
  // Check if CiviCRM is properly configured
  if (\Drupal::hasService('commerce_civicrm.civicrm_helper')) {
    try {
      $helper = \Drupal::service('commerce_civicrm.civicrm_helper');
      if ($helper->isAvailable()) {
        $requirements['commerce_civicrm_status'] = [
          'title' => t('Commerce CiviCRM - CiviCRM Status'),
          'description' => t('CiviCRM is properly configured and available.'),
          'severity' => RequirementSeverity::OK,
          'value' => t('Available'),
        ];
      } else {
        $requirements['commerce_civicrm_status'] = [
          'title' => t('Commerce CiviCRM - CiviCRM Status'),
          'description' => t('CiviCRM is not properly configured or not accessible.'),
          'severity' => RequirementSeverity::Warning,
          'value' => t('Not accessible'),
        ];
      }
    } catch (\CRM_Core_Exception $e) {
      $requirements['commerce_civicrm_status'] = [
        'title' => t('Commerce CiviCRM - CiviCRM Status'),
        'description' => t('Error checking CiviCRM status: @error', ['@error' => $e->getMessage()]),
        'severity' => RequirementSeverity::Error,
        'value' => t('Error'),
      ];
    }
  }
  
  return $requirements;
}

/**
 * Implements hook_uninstall().
 */
function commerce_civicrm_uninstall() {
  $config_factory = \Drupal::configFactory();
  
  // List of configuration objects to delete.
  $config_names = [
    'commerce_civicrm.settings',
    'views.view.commerce_civicrm_my_orders',
  ];

  // Delete configuration objects.
  foreach ($config_names as $config_name) {
    $config = $config_factory->getEditable($config_name);
    if (!$config->isNew()) {
      $config->delete();
    }
  }

  // Remove the field_civicrm field from all product bundles
  $field_config = \Drupal::entityTypeManager()->getStorage('field_config');
  $field_storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  
  // Get all product bundles
  $product_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('commerce_product');
  
  // Remove field from all product bundles
  foreach ($product_bundles as $bundle => $info) {
    $field = $field_config->load('commerce_product.' . $bundle . '.field_civicrm');
    if ($field) {
      $field->delete();
    }
  }
  
  // Remove field storage
  $storage = $field_storage->load('commerce_product.field_civicrm');
  if ($storage) {
    $storage->delete();
  }

  // Remove CiviCRM custom fields.
  try {
    if (\Drupal::hasService('commerce_civicrm.civicrm_helper')) {
      $helper = \Drupal::service('commerce_civicrm.civicrm_helper');
      if ($helper->initialize()) {
        \Civi\Api4\CustomGroup::delete(FALSE)
          ->addWhere('name', '=', 'Commerce_Order')
          ->execute();
      }
    }
  } catch (\CRM_Core_Exception $e) {
    \Drupal::logger('commerce_civicrm')->warning('Could not remove CiviCRM custom fields during uninstall: @message', [
      '@message' => $e->getMessage(),
    ]);
  }

  // Clear relevant caches to ensure clean removal.
  \Drupal::cache('discovery')->deleteAll();
  \Drupal::cache('config')->deleteAll();
  
  // Clear views cache specifically.
  if (\Drupal::hasService('views.executable')) {
    views_invalidate_cache();
  }
  
  // Clear field caches
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Implements hook_install().
 */
function commerce_civicrm_install() {
  // Add the CiviCRM field to all existing product types
  // This uses the helper function that will also be used for new product types
  $results = commerce_civicrm_add_field_to_all_product_types();
  
  if (!empty($results['success'])) {
    \Drupal::messenger()->addMessage(t('CiviCRM field has been added to product types: @types. You can now configure CiviCRM integration on product edit forms.', [
      '@types' => implode(', ', $results['success']),
    ]));
  }
  
  if (empty($results['success']) && empty($results['failed'])) {
    \Drupal::messenger()->addMessage(t('No product types found. The CiviCRM field will be automatically added to new product types as they are created.'));
  }

  // Provision CiviCRM custom fields for order-to-contribution linking.
  _commerce_civicrm_provision_custom_fields();
}

/**
 * Creates the Commerce_Order custom group and its fields in CiviCRM.
 *
 * @return bool
 *   TRUE if the custom fields exist or were created, FALSE on failure.
 */
function _commerce_civicrm_provision_custom_fields() {
  if (!\Drupal::hasService('commerce_civicrm.civicrm_helper')) {
    \Drupal::logger('commerce_civicrm')->warning('CiviCRM helper not available during install — custom fields not provisioned. They will be created on first use.');
    return FALSE;
  }

  return \Drupal::service('commerce_civicrm.civicrm_helper')->ensureCommerceOrderCustomFields();
}
