name: 'Commerce CiviCRM'
type: module
description: 'Integrates Drupal Commerce with CiviCRM, allowing products to be mapped to CiviCRM memberships or contributions.'
package: Commerce
# core_version_requirement has been updated to support Drupal 10 and 11.
core_version_requirement: ^10 || ^11
dependencies:
  - 'drupal:commerce_product'
  - 'drupal:commerce_order'
  - 'civicrm:civicrm'

# Note: It is assumed that the CiviCRM module itself is compatible with Drupal 11.
# You must ensure that your CiviCRM installation is up to date and correctly integrated
# with your Drupal 11 site.
