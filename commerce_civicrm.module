<?php

/**
 * @file
 * Main module file for the Commerce CiviCRM module.
 * This file contains the primary hooks and logic for integrating
 * Drupal Commerce with CiviCRM.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function commerce_civicrm_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the commerce_civicrm module.
    case 'help.page.commerce_civicrm':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Commerce CiviCRM module integrates Drupal Commerce with CiviCRM. It allows you to associate Commerce products with CiviCRM memberships or contributions. When a customer purchases such a product, the corresponding membership or contribution is created or updated in CiviCRM.') . '</p>';
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('To configure CiviCRM integration, edit a Commerce product and go to the "CiviCRM" tab. You can enable CiviCRM processing and map the product to a specific CiviCRM membership or contribution type.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for commerce_product_form.
 *
 * Adds a CiviCRM tab to the product edit form.
 *
 * In Drupal 10/11, many form alterations remain similar, but it's crucial
 * to ensure all service injections and class references are up to date if this
 * were converted to a form class. For a simple hook, this structure is still valid.
 */
function commerce_civicrm_form_commerce_product_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $form_state->getFormObject()->getEntity();

  // Initialize CiviCRM if it hasn't been already.
  // This is a safeguard. In a typical Drupal 11 environment, CiviCRM's
  // services should be available if the CiviCRM module is enabled.
  if (!class_exists('CRM_Core_Config')) {
    \Drupal::service('civicrm')->initialize();
  }

  // Get CiviCRM settings for this product.
  $civicrm_settings = $product->get('field_civicrm')->getValue();
  $civicrm_enabled = !empty($civicrm_settings[0]['enabled']) ? $civicrm_settings[0]['enabled'] : 0;
  $civicrm_entity = !empty($civicrm_settings[0]['entity']) ? $civicrm_settings[0]['entity'] : 'contribution';
  $civicrm_entity_id = !empty($civicrm_settings[0]['entity_id']) ? $civicrm_settings[0]['entity_id'] : NULL;

  $form['civicrm'] = [
    '#type' => 'details',
    '#title' => t('CiviCRM Integration'),
    '#group' => 'advanced',
    '#weight' => 90,
    '#open' => TRUE,
  ];

  $form['civicrm']['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable CiviCRM Processing for this Product'),
    '#default_value' => $civicrm_enabled,
  ];

  $form['civicrm']['entity'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Entity Type'),
    '#options' => [
      'contribution' => t('Contribution'),
      'membership' => t('Membership'),
    ],
    '#default_value' => $civicrm_entity,
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];

  // Fetch membership types for the dropdown.
  // Using APIv4 is preferred in modern CiviCRM, but APIv3 is still widely used
  // and functional in 6.3 for this purpose. An upgrade to APIv4 would be a
  // good future improvement.
  try {
    $membership_types = civicrm_api3('MembershipType', 'get', [
      'sequential' => 1,
      'is_active' => 1,
      'options' => ['limit' => 0],
    ]);
    $membership_options = [];
    if (!empty($membership_types['values'])) {
      foreach ($membership_types['values'] as $type) {
        $membership_options[$type['id']] = $type['name'];
      }
    }
  } catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to retrieve CiviCRM Membership Types: @message', ['@message' => $e->getMessage()]);
    $membership_options = [t('Error: Could not load membership types.')];
  }


  $form['civicrm']['membership_type'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Membership Type'),
    '#options' => $membership_options,
    '#default_value' => $civicrm_entity_id,
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'membership'],
      ],
    ],
  ];

  // Fetch contribution types for the dropdown.
  try {
    $contribution_types = civicrm_api3('FinancialType', 'get', [
        'sequential' => 1,
        'is_active' => 1,
        'options' => ['limit' => 0],
    ]);
    $contribution_options = [];
    if (!empty($contribution_types['values'])) {
        foreach ($contribution_types['values'] as $type) {
            $contribution_options[$type['id']] = $type['name'];
        }
    }
  } catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to retrieve CiviCRM Financial Types: @message', ['@message' => $e->getMessage()]);
    $contribution_options = [t('Error: Could not load contribution types.')];
  }


  $form['civicrm']['contribution_type'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Financial Type'),
    '#options' => $contribution_options,
    '#default_value' => $civicrm_entity_id,
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'contribution'],
      ],
    ],
  ];

  // Add a custom submit handler to save the CiviCRM settings.
  $form['actions']['submit']['#submit'][] = 'commerce_civicrm_product_form_submit';
}

/**
 * Custom submit handler for the product form.
 */
function commerce_civicrm_product_form_submit(&$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $form_state->getFormObject()->getEntity();

  $civicrm_enabled = !empty($values['civicrm']['enabled']);
  $civicrm_entity = $values['civicrm']['entity'];
  $civicrm_entity_id = NULL;

  if ($civicrm_enabled) {
    if ($civicrm_entity === 'membership') {
      $civicrm_entity_id = $values['civicrm']['membership_type'];
    } elseif ($civicrm_entity === 'contribution') {
      $civicrm_entity_id = $values['civicrm']['contribution_type'];
    }
  }

  // Save the data to the product's CiviCRM field.
  // This assumes you have a field named 'field_civicrm' on your product.
  // The field type should be a simple text or a custom field type capable of storing these settings.
  // For this example, we'll serialize the data into a text field.
  $settings = [
    'enabled' => $civicrm_enabled,
    'entity' => $civicrm_entity,
    'entity_id' => $civicrm_entity_id,
  ];

  $product->set('field_civicrm', serialize($settings));
  // The product is saved by the main form submit handler, so we don't need to call save() here.
}


/**
 * Implements hook_commerce_order_presave().
 *
 * This is a critical hook. When an order is being saved, we check if it has been
 * paid and if it contains products linked to CiviCRM.
 *
 * Note: In Drupal 10/11, it's often better to use Event Subscribers instead of hooks
 * for better performance and adherence to modern OOP practices. An upgrade could involve
 * converting this hook to an OrderEvent subscriber.
 */
function commerce_civicrm_commerce_order_presave(OrderInterface $order) {
  // Check if the order has just been paid.
  $original_state = isset($order->original) ? $order->original->getState()->getId() : NULL;
  $new_state = $order->getState()->getId();
  $is_paid = $order->isPaid();

  // Process only when the order is fully paid.
  // We also check original state to avoid processing the same order multiple times.
  if (!$is_paid || $original_state === $new_state) {
    return;
  }

  \Drupal::service('civicrm')->initialize();
  $user = $order->getCustomer();
  $params = [];

  // Find the CiviCRM contact ID for the Drupal user.
  try {
    $contact = civicrm_api3('UFMatch', 'get', [
      'sequential' => 1,
      'uf_id' => $user->id(),
    ]);
    if (empty($contact['id'])) {
      \Drupal::logger('commerce_civicrm')->warning('Could not find CiviCRM contact for user ID @uid.', ['@uid' => $user->id()]);
      return;
    }
    $contact_id = $contact['values'][0]['contact_id'];
  } catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Error finding CiviCRM contact: @message', ['@message' => $e->getMessage()]);
    return;
  }


  foreach ($order->getItems() as $order_item) {
    $product = $order_item->getPurchasedEntity()->getProduct();
    if (!$product || !$product->hasField('field_civicrm')) {
      continue;
    }

    $settings_raw = $product->get('field_civicrm')->value;
    if (empty($settings_raw)) {
        continue;
    }
    $settings = unserialize($settings_raw);

    if (empty($settings['enabled'])) {
      continue;
    }

    // Process based on entity type
    if ($settings['entity'] === 'membership' && !empty($settings['entity_id'])) {
      _commerce_civicrm_process_membership($order, $contact_id, $settings['entity_id']);
    } elseif ($settings['entity'] === 'contribution' && !empty($settings['entity_id'])) {
      _commerce_civicrm_process_contribution($order, $contact_id, $settings['entity_id']);
    }
  }
}

/**
 * Helper function to create/renew a CiviCRM membership.
 */
function _commerce_civicrm_process_membership(OrderInterface $order, $contact_id, $membership_type_id) {
  try {
    civicrm_api3('Membership', 'create', [
      'contact_id' => $contact_id,
      'membership_type_id' => $membership_type_id,
      'source' => 'Drupal Commerce Order ' . $order->id(),
      // Add other relevant parameters like join_date, start_date, etc.
      'join_date' => date('Y-m-d'),
      'status_id' => 'New', // Or calculate based on rules
    ]);
    \Drupal::logger('commerce_civicrm')->info('Successfully created/renewed membership for contact @cid from order @oid.', ['@cid' => $contact_id, '@oid' => $order->id()]);
  } catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to create membership: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Helper function to create a CiviCRM contribution.
 */
function _commerce_civicrm_process_contribution(OrderInterface $order, $contact_id, $financial_type_id) {
    try {
        civicrm_api3('Contribution', 'create', [
            'contact_id' => $contact_id,
            'financial_type_id' => $financial_type_id,
            'total_amount' => $order->getTotalPrice()->getNumber(),
            'currency' => $order->getTotalPrice()->getCurrencyCode(),
            'source' => 'Drupal Commerce Order ' . $order->id(),
            'contribution_status_id' => 'Completed',
        ]);
        \Drupal::logger('commerce_civicrm')->info('Successfully created contribution for contact @cid from order @oid.', ['@cid' => $contact_id, '@oid' => $order->id()]);
    } catch (\Exception $e) {
        \Drupal::logger('commerce_civicrm')->error('Failed to create contribution: @message', ['@message' => $e->getMessage()]);
    }
}
