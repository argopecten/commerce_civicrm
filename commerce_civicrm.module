<?php

/**
 * @file
 * Main module file for the Commerce CiviCRM module.
 *
 * This file contains the primary hooks and logic for integrating
 * Drupal Commerce with CiviCRM.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\Core\Form\FormStateInterface;
use Civi\Api4\MembershipType;
use Civi\Api4\FinancialType;

/**
 * Implements hook_help().
 */
function commerce_civicrm_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the commerce_civicrm module.
    case 'help.page.commerce_civicrm':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Commerce CiviCRM module integrates Drupal Commerce with CiviCRM. It allows you to associate Commerce products with CiviCRM memberships or financial types (for contributions). When a customer purchases a product, the corresponding CiviCRM record is created.') . '</p>';
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('To configure the integration, you must first add a text field named `field_civicrm` to the commerce product types you wish to enable. Then, edit a Commerce product and go to the "CiviCRM Integration" section in the advanced settings.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for commerce_product_form.
 *
 * Adds a CiviCRM integration settings form to the product edit form.
 */
function commerce_civicrm_form_commerce_product_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $form_state->getFormObject()->getEntity();

  // Ensure the product has the required field before proceeding.
  if (!$product->hasField('field_civicrm')) {
    return;
  }

  // Initialize CiviCRM.
  \Drupal::service('civicrm')->initialize();

  // Get CiviCRM settings for this product. Use json_decode for safer data handling.
  $civicrm_settings_raw = $product->get('field_civicrm')->value;
  $civicrm_settings = !empty($civicrm_settings_raw) ? json_decode($civicrm_settings_raw, TRUE) : [];
  
  $civicrm_enabled = $civicrm_settings['enabled'] ?? 0;
  $civicrm_entity = $civicrm_settings['entity'] ?? 'contribution';
  $civicrm_entity_id = $civicrm_settings['entity_id'] ?? NULL;

  $form['civicrm'] = [
    '#type' => 'details',
    '#title' => t('CiviCRM Integration'),
    '#group' => 'advanced',
    '#weight' => 90,
    '#open' => TRUE,
    // Add a check to ensure the field exists.
    '#access' => $product->hasField('field_civicrm'),
  ];

  $form['civicrm']['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable CiviCRM Processing for this Product'),
    '#default_value' => $civicrm_enabled,
  ];

  $form['civicrm']['entity'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Entity Type'),
    '#options' => [
      'contribution' => t('Contribution'),
      'membership' => t('Membership'),
    ],
    '#default_value' => $civicrm_entity,
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];

  // Fetch membership types using APIv4.
  $membership_options = [];
  try {
    $membership_types = MembershipType::get(FALSE)
      ->addWhere('is_active', '=', TRUE)
      ->setLimit(0)
      ->execute();
    foreach ($membership_types as $type) {
      $membership_options[$type['id']] = $type['name'];
    }
  } catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to retrieve CiviCRM Membership Types: @message', ['@message' => $e->getMessage()]);
    $membership_options[0] = t('Error: Could not load membership types.');
  }

  $form['civicrm']['membership_type'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Membership Type'),
    '#options' => $membership_options,
    '#default_value' => $civicrm_entity_id,
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'membership'],
      ],
    ],
  ];

  // Fetch financial types (for contributions) using APIv4.
  $contribution_options = [];
  try {
    $financial_types = FinancialType::get(FALSE)
      ->addWhere('is_active', '=', TRUE)
      ->setLimit(0)
      ->execute();
    foreach ($financial_types as $type) {
      $contribution_options[$type['id']] = $type['name'];
    }
  } catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to retrieve CiviCRM Financial Types: @message', ['@message' => $e->getMessage()]);
    $contribution_options[0] = t('Error: Could not load financial types.');
  }

  $form['civicrm']['contribution_type'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Financial Type'),
    '#options' => $contribution_options,
    '#default_value' => $civicrm_entity_id,
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'contribution'],
      ],
    ],
  ];

  // Add a custom submit handler to save the CiviCRM settings.
  // This ensures our handler runs in addition to the main one.
  array_unshift($form['actions']['submit']['#submit'], 'commerce_civicrm_product_form_submit');
}

/**
 * Custom submit handler for the product form.
 */
function commerce_civicrm_product_form_submit(&$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $form_state->getFormObject()->getEntity();

  if (!$product->hasField('field_civicrm')) {
    return;
  }

  $civicrm_enabled = !empty($values['civicrm']['enabled']);
  $civicrm_entity = $values['civicrm']['entity'];
  $civicrm_entity_id = NULL;

  if ($civicrm_enabled) {
    if ($civicrm_entity === 'membership') {
      $civicrm_entity_id = $values['civicrm']['membership_type'];
    } elseif ($civicrm_entity === 'contribution') {
      $civicrm_entity_id = $values['civicrm']['contribution_type'];
    }
  }

  // Save settings as a JSON string for safety and interoperability.
  $settings = [
    'enabled' => $civicrm_enabled,
    'entity' => $civicrm_entity,
    'entity_id' => $civicrm_entity_id,
  ];

  $product->set('field_civicrm', json_encode($settings));
  // No need to save the product here, the main entity form submit handler does it.
}
