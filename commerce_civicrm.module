    case 'help.page.commerce_civicrm':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Commerce CiviCRM module provides seamless integration between Drupal Commerce and CiviCRM. It automatically creates CiviCRM records (contacts, contributions, memberships) when customers complete orders containing CiviCRM-enabled products.') . '</p>';
      $output .= '<p>' . t('The module uses a modern service-based architecture with Commerce-style direct integration for reliable automatic processing.') . '</p>';
      
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Automatic contact creation and synchronization from Commerce customer profiles') . '</li>';
      $output .= '<li>' . t('Contribution tracking with customizable financial types') . '</li>';
      $output .= '<li>' . t('Membership management with automatic creation and renewal') . '</li>';
      $output .= '<li>' . t('Product field-based configuration for flexible automation') . '</li>';
      $output .= '<li>' . t('Commerce-native integration with workflow events') . '</li>';
      $output .= '<li>' . t('Views integration for displaying customer orders') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Requirements') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('CiviCRM module properly installed and configured') . '</li>';
      $output .= '<li>' . t('CiviCRM Tools module for modern API access') . '</li>';
      $output .= '<li>' . t('Drupal Commerce with Product, Order, and Payment modules') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('The module uses product field configuration for automation:') . '</p>';
      $output .= '<ol>';
      $output .= '<li>' . t('Add CiviCRM fields to your Commerce product types: field_civicrm_membership_type and field_civicrm_financial_type.') . '</li>';
      $output .= '<li>' . t('Edit any Commerce product to configure CiviCRM integration through these fields.') . '</li>';
      $output .= '<li>' . t('Set field values to specify which CiviCRM records to create when the product is purchased.') . '</li>';
      $output .= '<li>' . t('Test by placing an order and verifying CiviCRM records are created automatically.') . '</li>';
      $output .= '</ol>';
      
      $output .= '<h3>' . t('Usage') . '</h3>';
      $output .= '<p>' . t('Once configured, the integration works automatically:') . '</p>';
      $output .= '<ul>';
      $output .= '<li>' . t('When customers place orders, CiviCRM contacts are created or updated from customer profiles.') . '</li>';
      $output .= '<li>' . t('When orders are completed, CiviCRM records are created based on product field configuration:') . '</li>';
      $output .= '<li>' . t('&nbsp;&nbsp;• <strong>Contributions:</strong> Financial records with specified financial types') . '</li>';
      $output .= '<li>' . t('&nbsp;&nbsp;• <strong>Memberships:</strong> Membership records with specified types and durations') . '</li>';
      $output .= '<li>' . t('All CiviCRM operations are logged for debugging and audit purposes.') . '</li>';
      $output .= '<li>' . t('Use the "My CiviCRM Orders" view to let customers see their order history.') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Product Field Configuration') . '</h3>';
      $output .= '<p>' . t('The module uses product fields for configuration:') . '</p>';
      $output .= '<ul>';
      $output .= '<li>' . t('<strong>field_civicrm_membership_type:</strong> Set to create memberships when product is purchased') . '</li>';
      $output .= '<li>' . t('<strong>field_civicrm_financial_type:</strong> Set to create contributions with specific financial type') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Troubleshooting') . '</h3>';
      $output .= '<p>' . t('If you encounter issues:') . '</p>';
      $output .= '<ul>';
      $output .= '<li>' . t('Check the Status Report (admin/reports/status) for CiviCRM connectivity issues.') . '</li>';
      $output .= '<li>' . t('Review the Commerce CiviCRM log messages at admin/reports/dblog.') . '</li>';
      $output .= '<li>' . t('Ensure CiviCRM and CiviCRM Tools modules are properly configured.') . '</li>';
      $output .= '<li>' . t('Verify that customer profiles contain the necessary contact information.') . '</li>';
      $output .= '</ul>';
      
      return $output;

    default:
      return '';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for commerce_product_form.
 *
 * Adds a CiviCRM integration settings form to the product edit form.
 */
function commerce_civicrm_form_commerce_product_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service('commerce_civicrm.product_form_helper')
    ->alterProductForm($form, $form_state, $form_id);
}

/**
 * Custom submit handler for the product form.
 */
function commerce_civicrm_product_form_submit(&$form, FormStateInterface $form_state) {
  \Drupal::service('commerce_civicrm.product_form_helper')
    ->submitProductForm($form, $form_state);
}

/**
 * Implements hook_commerce_product_type_insert().
 *
 * Automatically adds the CiviCRM field to newly created product types.
 */
function commerce_civicrm_commerce_product_type_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'commerce_product_type') {
    $bundle = $entity->id();
    commerce_civicrm_add_field_to_product_type($bundle);
    
    \Drupal::logger('commerce_civicrm')->info('Automatically added CiviCRM field to new product type: @bundle', [
      '@bundle' => $bundle,
    ]);
  }
}

/**
 * Helper function to add the CiviCRM field to a specific product type.
 *
 * @param string $bundle
 *   The machine name of the product type bundle.
 *
 * @return bool
 *   TRUE if the field was added or already exists, FALSE on error.
 */
function commerce_civicrm_add_field_to_product_type($bundle) {
  try {
    $field_storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
    $field_config = \Drupal::entityTypeManager()->getStorage('field_config');
    
    // Ensure field storage exists
    $storage_exists = $field_storage->load('commerce_product.field_civicrm');
    if (!$storage_exists) {
      $field_storage->create([
        'field_name' => 'field_civicrm',
        'entity_type' => 'commerce_product',
        'type' => 'text_long',
        'cardinality' => 1,
        'settings' => [],
      ])->save();
    }
    
    // Check if field already exists on this bundle
    $field_exists = $field_config->load('commerce_product.' . $bundle . '.field_civicrm');
    if ($field_exists) {
      return TRUE; // Already exists
    }
    
    // Create field instance for this bundle
    $field_config->create([
      'field_name' => 'field_civicrm',
      'entity_type' => 'commerce_product',
      'bundle' => $bundle,
      'label' => 'CiviCRM Integration Settings',
      'description' => 'Configuration for CiviCRM integration when this product is purchased.',
      'required' => FALSE,
      'settings' => [],
      'default_value' => [],
    ])->save();
    
    // Set the field to be hidden by default in form and view displays
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('commerce_product.' . $bundle . '.default');
    
    if ($form_display) {
      $form_display->removeComponent('field_civicrm')->save();
    }
    
    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('commerce_product.' . $bundle . '.default');
    
    if ($view_display) {
      $view_display->removeComponent('field_civicrm')->save();
    }
    
    \Drupal::logger('commerce_civicrm')->notice('CiviCRM field added to product type: @bundle', ['@bundle' => $bundle]);
    
    return TRUE;
  }
  catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to add CiviCRM field to product type @bundle: @message', [
      '@bundle' => $bundle,
      '@message' => $e->getMessage(),
    ]);
    return FALSE;
  }
}

/**
 * Helper function to add the CiviCRM field to all existing product types.
 *
 * This function can be called manually if needed to ensure all product types
 * have the CiviCRM field, for example after troubleshooting or in update hooks.
 *
 * @return array
 *   An associative array with 'success' and 'failed' keys containing
 *   arrays of product type machine names.
 */
function commerce_civicrm_add_field_to_all_product_types() {
  $results = ['success' => [], 'failed' => []];
  
  try {
    // Get all product bundles
    $product_bundles = \Drupal::service('entity_type.bundle.info')->getBundleInfo('commerce_product');
    
    foreach ($product_bundles as $bundle => $info) {
      if (commerce_civicrm_add_field_to_product_type($bundle)) {
        $results['success'][] = $bundle;
      } else {
        $results['failed'][] = $bundle;
      }
    }
    
    if (!empty($results['success'])) {
      \Drupal::messenger()->addMessage(t('CiviCRM field added to product types: @types', [
        '@types' => implode(', ', $results['success']),
      ]));
    }
    
    if (!empty($results['failed'])) {
      \Drupal::messenger()->addError(t('Failed to add CiviCRM field to product types: @types', [
        '@types' => implode(', ', $results['failed']),
      ]));
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to add CiviCRM field to all product types: @message', [
      '@message' => $e->getMessage(),
    ]);
    $results['failed'][] = 'Error: ' . $e->getMessage();
  }
  
  return $results;
}
