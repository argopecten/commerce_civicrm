<?php

/**
 * @file
 * Main module file for the Commerce CiviCRM module.
 *
 * This file contains the primary hooks and logic for integrating
 * Drupal Commerce with CiviCRM.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Form\FormStateInterface;


/**
 * Implements hook_help().
 */
function commerce_civicrm_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.commerce_civicrm':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Commerce CiviCRM module provides seamless integration between Drupal Commerce and CiviCRM. It automatically creates CiviCRM records (contacts, contributions, memberships, and events) when customers complete orders containing CiviCRM-enabled products.') . '</p>';
      $output .= '<p>' . t('The module uses a modern service-based architecture with proper dependency injection and supports both CiviCRM contributions and memberships with automatic contact synchronization.') . '</p>';
      
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Automatic contact creation and synchronization from Commerce customer profiles') . '</li>';
      $output .= '<li>' . t('Contribution tracking with customizable financial types') . '</li>';
      $output .= '<li>' . t('Membership management with automatic creation and renewal') . '</li>';
      $output .= '<li>' . t('Event registration with customizable participant roles') . '</li>';
      $output .= '<li>' . t('Mailing list subscription with double opt-in and welcome messages') . '</li>';
      $output .= '<li>' . t('Rules integration for advanced workflow automation') . '</li>';
      $output .= '<li>' . t('Views integration for displaying customer orders') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Requirements') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('CiviCRM module properly installed and configured') . '</li>';
      $output .= '<li>' . t('CiviCRM Tools module for modern API access') . '</li>';
      $output .= '<li>' . t('Drupal Commerce with Product, Order, and Payment modules') . '</li>';
      $output .= '<li>' . t('Rules module for advanced automation (optional)') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('The module automatically configures itself during installation:') . '</p>';
      $output .= '<ol>';
      $output .= '<li>' . t('The required "field_civicrm" field is automatically added to all Commerce product types during module installation.') . '</li>';
      $output .= '<li>' . t('Edit any Commerce product to configure CiviCRM integration in the "CiviCRM Integration" section.') . '</li>';
      $output .= '<li>' . t('Choose whether to create contributions, memberships, event registrations, or mailing subscriptions when the product is purchased.') . '</li>';
      $output .= '<li>' . t('Select the appropriate CiviCRM entity (Financial Type, Membership Type, Event, or Mailing Group).') . '</li>';
      $output .= '<li>' . t('Configure additional options like participant roles for events or mailing preferences.') . '</li>';
      $output .= '<li>' . t('Configure Rules for advanced automation workflows if needed.') . '</li>';
      $output .= '</ol>';
      
      $output .= '<h3>' . t('Usage') . '</h3>';
      $output .= '<p>' . t('Once configured, the integration works automatically:') . '</p>';
      $output .= '<ul>';
      $output .= '<li>' . t('When customers place orders, CiviCRM contacts are created or updated from customer profiles.') . '</li>';
      $output .= '<li>' . t('When orders are completed, CiviCRM records are created based on product configuration:') . '</li>';
      $output .= '<li>' . t('&nbsp;&nbsp;• <strong>Contributions:</strong> Financial records with specified financial types') . '</li>';
      $output .= '<li>' . t('&nbsp;&nbsp;• <strong>Memberships:</strong> Membership records with specified types and durations') . '</li>';
      $output .= '<li>' . t('&nbsp;&nbsp;• <strong>Events:</strong> Event registrations with customizable participant roles') . '</li>';
      $output .= '<li>' . t('&nbsp;&nbsp;• <strong>Mailings:</strong> Mailing list subscriptions with optional double opt-in and welcome messages') . '</li>';
      $output .= '<li>' . t('All CiviCRM operations are logged for debugging and audit purposes.') . '</li>';
      $output .= '<li>' . t('Use the "My CiviCRM Orders" view to let customers see their order history.') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Rules Integration') . '</h3>';
      $output .= '<p>' . t('The module provides Rules actions for advanced workflows:') . '</p>';
      $output .= '<ul>';
      $output .= '<li>' . t('<strong>Add a CiviCRM Contribution:</strong> Create contributions with custom financial types') . '</li>';
      $output .= '<li>' . t('<strong>Add a CiviCRM Membership:</strong> Create or renew memberships with specific types') . '</li>';
      $output .= '<li>' . t('<strong>Add a CiviCRM Event Registration:</strong> Register users for events with participant roles') . '</li>';
      $output .= '<li>' . t('<strong>Add to CiviCRM Mailing Group:</strong> Subscribe users to mailing groups with preferences') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Troubleshooting') . '</h3>';
      $output .= '<p>' . t('If you encounter issues:') . '</p>';
      $output .= '<ul>';
      $output .= '<li>' . t('Check the Status Report (admin/reports/status) for CiviCRM connectivity issues.') . '</li>';
      $output .= '<li>' . t('Review the Commerce CiviCRM log messages at admin/reports/dblog.') . '</li>';
      $output .= '<li>' . t('Ensure CiviCRM and CiviCRM Tools modules are properly configured.') . '</li>';
      $output .= '<li>' . t('Verify that customer profiles contain the necessary contact information.') . '</li>';
      $output .= '</ul>';
      
      return $output;

    default:
      return '';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for commerce_product_form.
 *
 * Adds a CiviCRM integration settings form to the product edit form.
 */
function commerce_civicrm_form_commerce_product_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $form_state->getFormObject()->getEntity();

  // Ensure the product has the required field before proceeding.
  if (!$product->hasField('field_civicrm')) {
    return;
  }

  // Check if CiviCRM is available before proceeding.
  if (!_commerce_civicrm_is_available()) {
    return;
  }

  // Get existing CiviCRM settings for this product.
  $civicrm_settings = _commerce_civicrm_get_product_settings($product);

  // Build the CiviCRM integration form section.
  $form['civicrm'] = [
    '#type' => 'details',
    '#title' => t('CiviCRM Integration'),
    '#group' => 'advanced',
    '#weight' => 90,
    '#open' => !empty($civicrm_settings['enabled']),
    '#access' => TRUE,
  ];
 
  $form['civicrm']['enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable CiviCRM Processing for this Product'),
    '#description' => t('When enabled, purchasing this product will create records in CiviCRM.'),
    '#default_value' => $civicrm_settings['enabled'],
  ];

  $form['civicrm']['entity'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Entity Type'),
    '#description' => t('Choose what type of CiviCRM record to create when this product is purchased.'),
    '#options' => [
      'contribution' => t('Contribution (Donation)'),
      'membership' => t('Membership'),
      'event' => t('Event Registration'),
      'mailing' => t('Mailing List Subscription'),
    ],
    '#default_value' => $civicrm_settings['entity'],
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
      ],
    ],
  ];

  // Add membership type selection.
  $membership_options = _commerce_civicrm_get_membership_types();
  $form['civicrm']['membership_type'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Membership Type'),
    '#description' => t('Select the membership type to create when this product is purchased.'),
    '#options' => $membership_options,
    '#default_value' => $civicrm_settings['entity_id'],
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'membership'],
      ],
    ],
  ];

  // Add financial type selection.
  $financial_options = _commerce_civicrm_get_financial_types();
  $form['civicrm']['contribution_type'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Financial Type'),
    '#description' => t('Select the financial type for contributions created when this product is purchased.'),
    '#options' => $financial_options,
    '#default_value' => $civicrm_settings['entity_id'],
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'contribution'],
      ],
    ],
  ];

  // Add event selection.
  $event_options = _commerce_civicrm_get_events();
  $form['civicrm']['event_id'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Event'),
    '#description' => t('Select the event for which to register participants when this product is purchased.'),
    '#options' => $event_options,
    '#default_value' => $civicrm_settings['entity_id'],
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'event'],
      ],
    ],
  ];

  // Add participant role selection for events.
  $participant_role_options = _commerce_civicrm_get_participant_roles();
  $form['civicrm']['participant_role_id'] = [
    '#type' => 'select',
    '#title' => t('Participant Role'),
    '#description' => t('Select the role for event participants.'),
    '#options' => $participant_role_options,
    '#default_value' => $civicrm_settings['participant_role_id'] ?? '',
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'event'],
      ],
    ],
  ];

  // Add mailing group selection.
  $mailing_options = _commerce_civicrm_get_mailing_groups();
  $form['civicrm']['mailing_group_id'] = [
    '#type' => 'select',
    '#title' => t('CiviCRM Mailing Group'),
    '#description' => t('Select the mailing group to add contacts to when this product is purchased.'),
    '#options' => $mailing_options,
    '#default_value' => $civicrm_settings['entity_id'],
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'mailing'],
      ],
    ],
  ];

  // Add mailing subscription preferences.
  $form['civicrm']['mailing_preferences'] = [
    '#type' => 'checkboxes',
    '#title' => t('Mailing Preferences'),
    '#description' => t('Select the subscription preferences for mailing list subscribers.'),
    '#options' => [
      'double_opt_in' => t('Require double opt-in confirmation'),
      'send_welcome' => t('Send welcome message'),
      'update_existing' => t('Update existing subscribers'),
    ],
    '#default_value' => $civicrm_settings['mailing_preferences'] ?? [],
    '#states' => [
      'visible' => [
        ':input[name="civicrm[enabled]"]' => ['checked' => TRUE],
        ':input[name="civicrm[entity]"]' => ['value' => 'mailing'],
      ],
    ],
  ];

  // Add custom submit handler to save the CiviCRM settings.
  array_unshift($form['actions']['submit']['#submit'], 'commerce_civicrm_product_form_submit');
}

/**
 * Custom submit handler for the product form.
 */
function commerce_civicrm_product_form_submit(&$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $form_state->getFormObject()->getEntity();

  if (!$product->hasField('field_civicrm')) {
    return;
  }

  $civicrm_enabled = !empty($values['civicrm']['enabled']);
  $civicrm_entity = $values['civicrm']['entity'] ?? 'contribution';
  $civicrm_entity_id = NULL;
  $additional_settings = [];

  if ($civicrm_enabled) {
    switch ($civicrm_entity) {
      case 'membership':
        $civicrm_entity_id = $values['civicrm']['membership_type'] ?? NULL;
        break;
        
      case 'contribution':
        $civicrm_entity_id = $values['civicrm']['contribution_type'] ?? NULL;
        break;
        
      case 'event':
        $civicrm_entity_id = $values['civicrm']['event_id'] ?? NULL;
        $additional_settings['participant_role_id'] = $values['civicrm']['participant_role_id'] ?? NULL;
        break;
        
      case 'mailing':
        $civicrm_entity_id = $values['civicrm']['mailing_group_id'] ?? NULL;
        $additional_settings['mailing_preferences'] = array_filter($values['civicrm']['mailing_preferences'] ?? []);
        break;
    }
  }

  // Save settings as a JSON string for consistency.
  $settings = [
    'enabled' => $civicrm_enabled,
    'entity' => $civicrm_entity,
    'entity_id' => $civicrm_entity_id,
  ];

  // Add additional settings if any.
  if (!empty($additional_settings)) {
    $settings = array_merge($settings, $additional_settings);
  }

  $product->set('field_civicrm', json_encode($settings));
  // The main entity form submit handler will save the product.
}

/**
 * Helper function to check if CiviCRM is available.
 *
 * @return bool
 *   TRUE if CiviCRM is available, FALSE otherwise.
 */
function _commerce_civicrm_is_available() {
  try {
    $helper = \Drupal::service('commerce_civicrm.civicrm_helper');
    return $helper->isAvailable();
  }
  catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('CiviCRM helper service failed: @message', ['@message' => $e->getMessage()]);
    return FALSE;
  }
}

/**
 * Helper function to get CiviCRM settings for a product.
 *
 * @param \Drupal\commerce_product\Entity\ProductInterface $product
 *   The Commerce product entity.
 *
 * @return array
 *   Array of CiviCRM settings with defaults.
 */
function _commerce_civicrm_get_product_settings($product) {
  $defaults = [
    'enabled' => FALSE,
    'entity' => 'contribution',
    'entity_id' => NULL,
  ];

  if (!$product->hasField('field_civicrm') || $product->get('field_civicrm')->isEmpty()) {
    return $defaults;
  }

  $civicrm_settings_raw = $product->get('field_civicrm')->value;
  $civicrm_settings = json_decode($civicrm_settings_raw, TRUE);

  return is_array($civicrm_settings) ? array_merge($defaults, $civicrm_settings) : $defaults;
}

/**
 * Helper function to get CiviCRM membership types.
 *
 * @return array
 *   Array of membership type options keyed by ID.
 */
function _commerce_civicrm_get_membership_types() {
  if (!_commerce_civicrm_is_available()) {
    return ['' => t('CiviCRM not available')];
  }

  try {
    $membership_updater = \Drupal::service('commerce_civicrm.membership_updater');
    return $membership_updater->getMembershipTypes();
  }
  catch (\Exception $e) {
    \Drupal::logger('commerce_civicrm')->error('Failed to get membership types: @message', ['@message' => $e->getMessage()]);
    return ['' => t('Error loading membership types')];
  }
}

